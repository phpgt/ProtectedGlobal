{
	"name": "phpgt/protectedglobal",
	"description": "Protect against accidental use of superglobals.",
	"license": [
		"MIT"
	],

	"require": {
		"php": ">=8.2"
	},
	"require-dev": {
		"phpstan/phpstan": "^2.1",
		"phpunit/phpunit": "^11.5",
		"phpmd/phpmd": "^2.13",
		"squizlabs/php_codesniffer": "^3.7"
	},

	"autoload": {
		"psr-4": {
			"GT\\ProtectedGlobal\\": "./src/",
			"Gt\\ProtectedGlobal\\": "./src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"GT\\ProtectedGlobal\\Test\\": "./test/phpunit"
		}
	},

	"scripts": {
		"phpunit": "vendor/bin/phpunit --configuration phpunit.xml",
		"phpstan": "vendor/bin/phpstan analyse --memory-limit=512M --level 7 src",
		"phpcs": "vendor/bin/phpcs src --standard=phpcs.xml",
		"phpmd": "vendor/bin/phpmd src/ text phpmd.xml",
		"test": [
			"@phpunit",
			"@phpstan",
			"@phpcs",
			"@phpmd"
		]
	},

	"funding": [
		{
			"type": "github",
			"url": "https://github.com/sponsors/PhpGt"
		}
	]
}
